<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inspire_hand_ros2</name>
  <version>0.1.0</version>
  <description>ROS2 driver, Booster T1 bridge and manual control GUI for the Inspire RH56 (RH56DFX) dexterous hand</description>
  <maintainer email="cudhnam123@gmail.com">robothand</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- booster_bridge also needs booster_interface from github.com/BoosterRobotics/booster_robotics_sdk_ros2;
       it is left out here so the direct driver builds without it. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
